<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PeopleTaskMobile.SplashPage">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#AEB784" Offset="0.0" />
                <GradientStop Color="#E3DBBB" Offset="0.5" />
                <GradientStop Color="#F8F3E1" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="24">

            <Grid WidthRequest="170" HeightRequest="170">
                <Ellipse Fill="#F8F3E1" WidthRequest="170" HeightRequest="170" Opacity="0.9">
                    <Ellipse.Shadow>
                        <Shadow Brush="#41431B" Offset="0,6" Radius="20" Opacity="0.25" />
                    </Ellipse.Shadow>
                </Ellipse>
                <Ellipse Fill="#E3DBBB" WidthRequest="150" HeightRequest="150"
                         HorizontalOptions="Center" VerticalOptions="Center" />
                <Ellipse Fill="#AEB784" WidthRequest="112" HeightRequest="112"
                         HorizontalOptions="Center" VerticalOptions="Center" />
                <Path Data="M 25,40 L 36,51 L 58,25"
                      Stroke="#41431B"
                      StrokeThickness="8"
                      StrokeLineCap="Round"
                      StrokeLineJoin="Round"
                      WidthRequest="56"
                      HeightRequest="56"
                      Aspect="Uniform"
                      HorizontalOptions="Center"
                      VerticalOptions="Center" />
            </Grid>

            <VerticalStackLayout Spacing="4">
                <Label Text="NexTick"
                       FontSize="34"
                       FontAttributes="Bold"
                       TextColor="#41431B"
                       HorizontalOptions="Center" />
                <Label Text="Stay on track"
                       FontSize="16"
                       TextColor="#5C5E2E"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </Grid>

</ContentPage>
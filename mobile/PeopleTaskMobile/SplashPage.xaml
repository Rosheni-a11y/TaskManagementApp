<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PeopleTaskMobile.SplashPage"
             BackgroundColor="#F8F3E1">

    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="20">

        <Grid WidthRequest="160" HeightRequest="160">
            <Ellipse Fill="#E3DBBB" WidthRequest="160" HeightRequest="160" />
            <Ellipse Fill="#AEB784" WidthRequest="120" HeightRequest="120" 
                     HorizontalOptions="Center" VerticalOptions="Center" />
            <Path Data="M 20,32 L 34,46 L 62,14" 
                  Stroke="#F8F3E1" 
                  StrokeThickness="9" 
                  StrokeLineCap="Round" 
                  StrokeLineJoin="Round"
                  WidthRequest="60"
                  HeightRequest="60"
                  Aspect="Uniform"
                  HorizontalOptions="Center" 
                  VerticalOptions="Center" />
        </Grid>

        <Label Text="NexTick" 
               FontSize="32" 
               FontAttributes="Bold"
               TextColor="#41431B" 
               HorizontalOptions="Center" />
        <Label Text="Stay on track" 
               FontSize="16" 
               TextColor="#7A7A55" 
               HorizontalOptions="Center" />
    </VerticalStackLayout>

</ContentPage>